// -*- mode:c++ -*-

// Processing-in-memory (PIM) instruction formats: thin wrappers that
// call the stock LoadStoreBase and VMemBase, with the stock templates and
// base classes, and fix the PIM request flags, the OpClass, the body and
// the address guard of every PIM instruction. The argument is the PimOp
// name (src/mem/pim_op.hh).

let {{
def pimMemFlags(op):
    return ['PIM', 'UNCACHEABLE', 'STRICT_ORDER',
            'pimOpFlags(PimOp::%s)' % op]

# Scalar forms: one 8-byte store of the descriptor at an 8-byte aligned
# address (SE checks no alignment by itself).
pim_scalar_ea = '''
    EA = rvSext(Rs1 + offset);
    if (EA & 0x7) {
        return std::make_shared<AddressFault>(
            EA, ExceptionCode::STORE_ADDR_MISALIGNED);
    }
'''

# Vector forms: the first micro-op faults if the instruction's bytes cross
# a page, before any request. A fault in a later micro-op sets vstart to
# its first element and the instruction restarts there (faults.cc,
# Decoder::armVstart); the last micro-op sets vstart back to 0.
pim_vec_ea = '''
    EA = Rs1 + vlenb * microIdx;
    if (microIdx == 0 && pimCrossesPage(Rs1,
            machInst.vl * (width_EEW(machInst.width) / 8))) {
        return std::make_shared<AddressFault>(Rs1, ExceptionCode::%s);
    }
    if (this->isLastMicroop() &&
            xc->tcBase()->readMiscRegNoEffect(MISCREG_VSTART) != 0) {
        xc->setMiscReg(MISCREG_VSTART, 0);
    }
'''

# Width-agnostic bodies: one class serves every EEW.
pim_vse_memacc = '''
    for (size_t b = 0; b < eewb; b++) {
        Mem_vc.as<uint8_t>()[i * eewb + b] = Vs3_ub[i * eewb + b];
    }
'''

# vm is always 1 (a decode key); the mask test is kept as in the stock
# loads, which also uses the template's v0 and ei.
pim_vle_memacc = '''
    if ((machInst.vm || elem_mask(v0, ei)) && i < this->microVl) {
        const size_t eewb = width_EEW(machInst.width) / 8;
        for (size_t b = 0; b < eewb; b++) {
            Vd_ub[i * eewb + b] = Mem_vc.as<uint8_t>()[i * eewb + b];
        }
    }
'''
}};

def format PimStore(op) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        LoadStoreBase(name, Name,
            'offset = sext<12>(IMM5 | (IMM7 << 5));', pim_scalar_ea,
            'Mem_ud = Rs2_ud;', pimMemFlags(op), ['IsPim', 'MemWriteOp'],
            'Store', exec_template_base='Store')
}};

def format PimVseOp(op) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, pim_vec_ea % 'STORE_ADDR_MISALIGNED',
                 pim_vse_memacc, pimMemFlags(op),
                 ['IsPim', 'SimdUnitStrideStoreOp'], 'VseMacroInst',
                 exec_template_base='Vse')
}};

def format PimVleOp(op) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, pim_vec_ea % 'LOAD_ADDR_MISALIGNED',
                 pim_vle_memacc, pimMemFlags(op),
                 ['IsPim', 'SimdUnitStrideLoadOp'], 'VleMacroInst',
                 exec_template_base='Vle')
}};
